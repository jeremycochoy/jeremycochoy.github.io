# Default server configuration
#

server {
       listen 80;
       listen [::]:80;
       server_name www.zenol.fr;
       rewrite ^(.*) http://zenol.fr$1 permanent;
}

server {
	listen 80;
	listen [::]:80;

	# SSL configuration
	#
	# listen 443 ssl default_server;
	# listen [::]:443 ssl default_server;
	#
	# Self signed certs generated by the ssl-cert package
	# Don't use them in a production server!
	#
	# include snippets/snakeoil.conf;

	root /var/www/perso;

	# Add index.php to the list if you are using PHP
	index index.html index.htm index.nginx-debian.html;

	server_name jeremy.cochoy.fr;
	server_name cochoy.fr;
	server_name www.cochoy.fr;
	server_name zenol.fr;
	#Alow caching
#	location ~* \.(htm|html)$ {
#	    expires 1d;
#	}
	location ~* \.(css)$ {
	    expires 1d;
	}
	location ~* \.(jpg|jpeg|png|gif|ico|js)$ {
	    expires 7d;
	}
	
	location ~* \.(.pdf)$ {
	    expires 30d;
	}

	location / {
	    #Legacy:
	    #CV
	    rewrite ^/cv(/)$ /resume/index.html redirect;
    	    rewrite ^/cv_2015.pdf$ /resume/index.html permanent;

	    # SedNL moved
            rewrite ^/sednl(.*) http://sednl.zenol.fr/doc$1 redirect;

	    ###
	    # Move blog to TechGate
	    ###
	    # Error handling strategy
	    rewrite ^/site/2013/08/27/an-alternative-error-handling-strategy-for-cpp(/)(.*)$ http://techgate.fr/haskell-pure-1 permanent;
	    rewrite ^/site/blog/posts/an-alternative-error-handling-strategy-cpp/en.html http://techgate.fr/an-alternative-error-handling-strategy-cpp permanent;
	    # Haskell Pure 2
	    rewrite ^/blog/haskell-pure-2/fr.html http://techgate.fr/haskell-pure-2 permanent;
	    rewrite ^/site/2013/04/26/le-haskell-un-langage-au-label-pure-seconde-partie(/)(.*)$ http://techgate.fr/haskell-pure-2 permanent;
	    # Haskell Pure 3
    	    rewrite ^/blog/haskell-pure-3/fr.html http://techgate.fr/haskell-pure-3 permanent;
	    rewrite ^/site/2013/05/03/le-haskell-un-langage-au-label-pure-troisieme-partie(/)(.*)$ http://techgate.fr/haskell-pure-3 permanent;

	    # Haskell Pure 1
	    rewrite ^/blog/haskell-pure-1/fr.html http://techgate.fr/haskell-pure-1 permanent;
	    rewrite ^/site/2013/04/16/le-haskell-un-language-au-label-pure-13(/)(.*)$ http://techgate.fr/haskell-pure-1 permanent;

	    # Gb Book
	    rewrite ^/gb-doc(.*) http://techgate.fr/gb-doc permanent;

	    # Global
            rewrite ^/site/blog/posts/(.*) http://techgate.fr/$1 permanent;
       	    rewrite ^/site/blog/pages/(.*) http://techgate.fr/$1 permanent;
            rewrite ^/site/blog(/) http://techgate.fr permanent;
    	    rewrite ^/blog/(.*)(/fr.html|/en.html) http://techgate.fr/$1 permanent;
       	    rewrite ^/blog/(.*) http://techgate.fr/$1 permanent;
	    rewrite ^/blog(/) http://techgate.fr permanent;
            rewrite ^/site(/) http://techgate.fr permanent;

	    ###
	    # Old stuff

            #Old trac repo
	    rewrite ^/trac/dev/browser/sfs(/)(.*) http://github.com/Zenol/vfs redirect;

	    #Error handling strategy
	    #SEDNL
	    rewrite ^/site/2013/08/21/sednl-simple-event-driven-network-library(/)(.*)$ /blog/sednl-simple-event-driven-network-library/fr.html permanent;

	    # Autoindex
	    autoindex on;

	    # First attempt to serve request as file, then
	    # as directory, then fall back to displaying a 404.
	    try_files $uri $uri/ =404;
	}

	location ~ /dl/ {
		 autoindex on;
	}
 	location ~ /shared/ {
		 autoindex on;
	}

	# Forbid access to other websites (nutriroad)
	location ^~ /wordpress_food/ {
	    deny all;
        }
	location ^~ /eshop/ {
	    deny all;
        }
	location ~ ngnix\.config$ {
	    deny all;
        }

	# pass the PHP scripts to FastCGI server listening on 127.0.0.1:9000
	#
	#location ~ \.php$ {
	#	include snippets/fastcgi-php.conf;
	#
	#	# With php5-cgi alone:
	#	fastcgi_pass 127.0.0.1:9000;
	#	# With php5-fpm:
	#	fastcgi_pass unix:/var/run/php5-fpm.sock;
	#}

	# deny access to .htaccess files, if Apache's document root
	# concurs with nginx's one
	#
	#location ~ /\.ht {
	#	deny all;
	#}
}


